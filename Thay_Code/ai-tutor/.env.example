# .env
# ─── AI API Keys ───────────────────────────
# ── Chọn provider (auto/openai/claude/gemini/openrouter)
AI_PROVIDER=auto

# ── API Keys (điền key của provider bạn có)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─── Cấu hình Camera ───────────────────────
# Độ phân giải detection + stream MJPEG (lores) — giữ 1280×720 để đảm bảo FPS
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
# Độ phân giải snapshot gửi AI (main stream) — tối đa 3280×2464 (8MP)
# 2560×1920 = 5MP cân bằng rõ/nhỏ, 3280×2464 = 8MP đầy đủ
SNAPSHOT_WIDTH=2560
SNAPSHOT_HEIGHT=1920

# ─── Giới hạn hiệu năng ────────────────────
# Detection FPS: MediaPipe chạy tối đa N lần/giây
# Benchmark RPi5: max vật lý ~12fps, đặt 10 → có idle time, quạt nhẹ hơn
DETECTION_FPS=10
# Stream FPS: số frame MJPEG gửi về browser/giây
STREAM_FPS=20

# Hiệu chỉnh màu IMX219 (Camera v2.1)
CAMERA_AWB_MODE=auto
# CAMERA_RED_GAIN=2.4    # Chỉ dùng khi AWB_MODE=manual
# CAMERA_BLUE_GAIN=1.8   # Chỉ dùng khi AWB_MODE=manual

# ─── Cấu hình AI Tutor ─────────────────────
STUDENT_NAME=Học sinh
DISTRACTION_THRESHOLD=10
REMINDER_COOLDOWN=60

# ─── Cấu hình Web Stream ───────────────────
STREAM_PORT=5000
STREAM_HOST=0.0.0.0

# Độ nhạy phát hiện chuyển động
# Càng nhỏ càng nhạy (5-50)
MOTION_THRESHOLD=20

# Diện tích tối thiểu để tính là chuyển động
# Càng nhỏ càng nhạy (300-5000)
MOTION_MIN_AREA=500

# ─── YOLO Object Detection ──────────────────
# Bật YOLO background thread để detect người và vật thể
YOLO_ENABLED=true
# Model chính (COCO 80 lớp): phone, person, mouse, keyboard, laptop...
YOLO_MODEL_PATH=yolo26n.pt
# Model phụ (Object365): chỉ detect pen + notepaper. Đặt rỗng để tắt.
YOLO_SECONDARY_MODEL_PATH=yolo26n-objv1-150.pt
# Kích thước ảnh đầu vào: 320=nhanh (~80ms), 416=cân bằng (~137ms)
YOLO_INPUT_SIZE=416
YOLO_CONFIDENCE=0.15
# Số frame bỏ qua giữa 2 lần inference (2 = ~3fps YOLO ở 10fps detection)
YOLO_SKIP_FRAMES=2

# Giới hạn số người theo dõi (1 = chỉ người gần nhất/lớn nhất trong frame)
MAX_PERSONS=1

# ─── Vị trí Camera ──────────────────────────
# "auto"  = tự động detect từ ear visibility (khuyến nghị)
# "right" = camera bên PHẢI người, "left" = bên TRÁI, "front" = phía trước
CAMERA_SIDE=auto
# IMX500 AI Camera
CAMERA_IMX500_ENABLED=true
YOLO_IMX500_MODEL_PATH=models/yolov8n_imx500.rpk
