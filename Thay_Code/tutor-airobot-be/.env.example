# ── Server ────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development          # development | production

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://tutor:tutor_dev_password@localhost:5432/tutor?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────
# JWT secret (min 32 chars)
JWT_SECRET=change-this-to-a-very-long-random-secret-key
# AES master key for encrypting API keys in DB (32 bytes hex)
# Generate: openssl rand -hex 32
AES_MASTER_KEY=change-this-to-32-byte-hex-key-here-00000000000000000000

# ── CORS ──────────────────────────────────────────────────────
# Admin frontend URL (whitelist)
ADMIN_FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug              # debug | info | warn | error

# ── Rate Limiting ─────────────────────────────────────────────
# Per device (RPi5): requests per minute
RATE_LIMIT_DEVICE_RPM=20
# Per IP (auth endpoints): requests per minute
RATE_LIMIT_AUTH_RPM=5
# Per admin user: requests per minute
RATE_LIMIT_ADMIN_RPM=300

# ── AI Defaults ───────────────────────────────────────────────
DEFAULT_AI_TIMEOUT_SEC=30
MAX_IMAGE_SIZE_MB=5

# ── JWT Expiry ────────────────────────────────────────────────
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7
